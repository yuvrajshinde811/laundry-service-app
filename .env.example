# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Leave empty to automatically use smart embedded in-memory fallback
MONGODB_URI=mongodb://127.0.0.1:27017/laundry_service

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_laundry_2026_change_in_production
JWT_EXPIRES_IN=7d

# Laundry Administrator Contact
# Admin WhatsApp number that receives order alerts (no + or spaces)
ADMIN_WHATSAPP_NUMBER=8080082714
ADMIN_DEFAULT_EMAIL=admin@laundry.com
ADMIN_DEFAULT_PASSWORD=Admin@123456

# Meta WhatsApp Business Cloud API (Optional - If omitted, falls back to Mock/Direct Chat mode)
WHATSAPP_API_TOKEN=your_meta_whatsapp_cloud_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# App URL (Used for generating tracking and callback links)
APP_BASE_URL=http://localhost:5000

# AI Assistant Configuration (Primary: Local Ollama - Completely Free)
# Set AI_ENABLED=false to disable AI endpoints while keeping all normal booking features active
AI_ENABLED=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
AI_MAX_TOKENS=600
AI_MAX_HISTORY_TURNS=10
AI_TIMEOUT_MS=45000

# Optional Alternative Providers (Set AI_PROVIDER=openai or AI_PROVIDER=gemini to use)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
